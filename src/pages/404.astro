---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url.js';
---
<Base title="Page not found" description="That page does not exist.">
  <section class="nf">
    <div class="wrap wrap-prose">
      <p class="eyebrow">404</p>
      <h1>That page isn't here.</h1>
      <p class="lede">The link may be out of date. These are the ones that work:</p>
      <ul>
        <li><a href={url('/')}>Home</a></li>
        <li><a href={url('/research')}>Research</a></li>
        <li><a href={url('/people')}>People</a></li>
        <li><a href={url('/publications')}>Publications</a></li>
        <li><a href={url('/software')}>Software</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(4rem, 12vw, 9rem); }
  ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1.2rem; }
</style>
