---
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';
import pubs from '../data/publications.json';

const visible = pubs.items.filter((p) => !p.embargoed);
const byYear = new Map();
for (const p of visible) {
  const y = p.year || 'Undated';
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y).push(p);
}
const years = [...byYear.keys()];
---
<Base title="Publications" description={`${visible.length} peer-reviewed papers and preprints from the Isom Lab, synced from ORCID.`}>
  <section class="intro">
    <div class="wrap">
      <h1>Publications</h1>
      <nav class="jump" aria-label="Jump to year">
        {years.map((y) => <a href={`#y${y}`}>{y}</a>)}
      </nav>
    </div>
  </section>

  {years.map((y) => (
    <section class="year" id={`y${y}`}>
      <div class="wrap row">
        <h2>{y}</h2>
        <div class="items">
          {byYear.get(y).map((p) => <Citation pub={p} />)}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 5.5rem) 2rem; }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.8rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .jump a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink-muted);
  }
  .jump a:hover { border-color: var(--accent); color: var(--accent-ink); }

  .year { scroll-margin-top: 80px; }
  .row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
  }
  .row h2 {
    font-size: var(--step-2);
    color: var(--ink-faint);
    margin: 0;
    position: sticky;
    top: 86px;
    align-self: start;
  }
  @media (max-width: 700px) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
    .row h2 { position: static; font-size: var(--step-1); color: var(--accent); }
  }
</style>
