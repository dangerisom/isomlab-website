---
import Base from '../layouts/Base.astro';
import { areas, approaches } from '../data/research.js';
---
<Base title="Research" description="Proton sensing by GPCRs, the dark proteome, and intercellular exchange — the three questions driving the Isom Lab.">
  <section class="intro">
    <div class="wrap wrap-prose">
      <p class="eyebrow">Research</p>
      <h1>Three questions</h1>
      <p class="lede">
        Our work is grounded in basic science. The goal is to understand how cells read
        and respond to their surroundings — and, where it follows, to find the openings
        that could inform new therapeutic strategies.
      </p>
    </div>
  </section>

  {areas.map((area) => (
    <section class="area section" id={area.id}>
      <div class="wrap grid">
        <div class="side">
          <span class="num">{area.number}</span>
          <ul class="keywords">
            {area.keywords.map((k) => <li>{k}</li>)}
          </ul>
        </div>
        <div class="body prose">
          <h2>{area.title}</h2>
          {area.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section class="section methods">
    <div class="wrap">
      <p class="eyebrow">Methods</p>
      <h2>How we study cells and proteins</h2>
      <div class="cols">
        {approaches.map((a) => (
          <div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem); }
  .grid { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); }
  .num {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--accent);
    display: block;
    line-height: 1;
  }
  .keywords { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .keywords li {
    font-size: 0.8rem;
    color: var(--ink-faint);
    padding-left: 0.9rem;
    border-left: 2px solid var(--rule-strong);
  }
  .body h2 { margin-bottom: 0.8rem; }
  .methods { background: var(--paper-sunk); }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2rem;
  }
  .cols h3 { font-size: var(--step-1); }
  .cols p { color: var(--ink-muted); font-size: 0.95rem; }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .keywords { flex-direction: row; flex-wrap: wrap; margin-top: 0.8rem; }
    .keywords li { border-left: 0; padding-left: 0; }
    .keywords li::after { content: '·'; margin-left: 0.5rem; color: var(--rule-strong); }
    .keywords li:last-child::after { content: ''; }
  }
</style>
