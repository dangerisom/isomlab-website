---
import Base from '../layouts/Base.astro';
import Citation from '../components/Citation.astro';
import { site } from '../data/site.js';
import { areas, approaches } from '../data/research.js';
import pubs from '../data/publications.json';
import { url } from '../utils/url.js';

// Six, not four: preprints sort below published work within a year, so a
// shorter list is all journal articles and the heading over-promises.
const recent = pubs.items.filter((p) => !p.embargoed).slice(0, 6);
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Molecular and Cellular Pharmacology&nbsp;· Sylvester Comprehensive Cancer Center</p>
      <h1>
        How cells sense their environment,{' '}
        <span class="alt">cooperate, and adapt</span>
      </h1>
      <p class="lede">
        We study the molecular and cellular basis of proton sensing, the dark proteome,
        and emerging mechanisms of intercellular communication — using computation,
        advanced imaging, structural and synthetic biology across normal human and
        cancer cells and model systems such as yeast.
      </p>
      <div class="cta">
        <a class="btn primary" href={url('/research')}>Our research</a>
        <a class="btn" href={url('/publications')}>Publications</a>
      </div>

      {/* Built from src/assets/RICTOR-3D-connection-1.mp4 -- see the README for
          how, and for what was retouched. Plays forward then backward, so the
          loop has no seam.
          The channels are TM184C (orange) and LysoTracker (green), recoloured
          by scripts/recolor-channels.py; the blue one is as acquired.
          The caption names none of them on purpose -- the paper is still under
          embargo. TODO(dan): put the labels back when it publishes, alongside
          deleting the EMBARGOED line in scripts/sync-publications.mjs. */}
      <figure
        class="banner"
        style={`--banner-poster: url(${url('/media/intercellular-connection.jpg')})`}
      >
        <video
          poster={url('/media/intercellular-connection.jpg')}
          width="1740"
          height="350"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src={url('/media/intercellular-connection.webm')} type="video/webm" />
          <source src={url('/media/intercellular-connection.mp4')} type="video/mp4" />
        </video>
        <figcaption>Live-cell confocal imaging of vesicles moving along a connection between two cells.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we study</p>
      <div class="areas">
        {areas.map((a) => (
          <a class="area" href={url(`/research#${a.id}`)}>
            <span class="num">{a.number}</span>
            <h3>{a.title}</h3>
            <p>{a.lede}</p>
            <span class="more">Read more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">How we work</p>
      <div class="approach">
        {approaches.map((a) => (
          <div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap head-row">
      <div>
        <p class="eyebrow">Recent work</p>
        <h2>Latest publications and preprints</h2>
      </div>
      <a class="btn" href={url('/publications')}>All {pubs.counts.total} publications</a>
    </div>
    <div class="wrap list">
      {recent.map((p) => <Citation pub={p} />)}
    </div>
  </section>

  <section class="section software">
    <div class="wrap head-row">
      <div>
        <p class="eyebrow">Open source</p>
        <h2>Software from the lab</h2>
        <p class="lede">
          Every tool we build for our own work is released, documented, and installable —
          several through Bioconda.
        </p>
      </div>
      <a class="btn" href={url('/software')}>Browse the tools</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.25rem) clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(ellipse 70% 60% at 82% 8%, var(--accent-soft), transparent 70%),
      var(--paper);
  }
  .hero h1 { max-width: 22ch; margin-bottom: 1.2rem; }
  .hero .alt { color: var(--ink-muted); }
  .hero .lede { margin-bottom: 2rem; }

  .banner { margin: 1.75rem 0 0; }
  .banner video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1740 / 350;
    /* `contain`, not `cover`: if the crop in make-banner.sh ever changes and
       this ratio does not, the clip letterboxes against a black background
       nobody can see, rather than silently cropping the cells off the ends. */
    object-fit: contain;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: #000;
  }
  /* No `--measure` cap here: the caption is written to sit on one line under
     the banner. It still wraps on a narrow screen, which is what should
     happen. */
  .banner figcaption {
    margin-top: 0.7rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  /* Anyone who has asked the OS to stop motion gets the poster frame instead.
     No script involved -- the still is the video's own first frame. */
  @media (prefers-reduced-motion: reduce) {
    .banner video { display: none; }
    .banner::before {
      content: '';
      display: block;
      aspect-ratio: 1740 / 350;
      background: #000 var(--banner-poster) center / cover no-repeat;
      border-radius: 10px;
      border: 1px solid var(--rule);
    }
  }

  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .btn {
    display: inline-block;
    padding: 0.62rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent-ink); }
  .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn.primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }


  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .area {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    background: var(--paper);
    text-decoration: none;
    transition: background 0.18s ease;
  }
  .area:hover { background: var(--paper-raised); }
  .area .num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .area h3 { font-size: var(--step-1); margin: 0; }
  .area p { color: var(--ink-muted); font-size: 0.94rem; flex: 1; }
  .area .more {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .area:hover .more { color: var(--accent); }

  .approach {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .approach h3 {
    font-size: var(--step-1);
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  .approach p { color: var(--ink-muted); font-size: 0.95rem; }

  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .head-row h2 { margin: 0; }
  .list { border-top: 1px solid var(--rule); }
  .software { background: var(--paper-sunk); }
  .software .lede { margin-top: 0.8rem; }
</style>
