---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Contact" description="Reach the Isom Lab at the University of Miami Miller School of Medicine.">
  <section class="intro">
    <div class="wrap grid">
      <div class="prose">
        <p class="eyebrow">Contact</p>
        <h1>Get in touch</h1>
        <p class="lede">
          For prospective trainees, collaborators, and anyone curious about the work —
          email is the fastest route.
        </p>
        <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>

      <aside>
        <h2>Where we are</h2>
        <address>
          Isom Lab<br />
          {site.affiliations.map((a) => <>{a}<br /></>)}
          Miami, Florida
        </address>

        <h2>Elsewhere</h2>
        <ul>
          <li><a href={site.social.github} rel="noopener">GitHub — isomlab</a></li>
          <li><a href={`https://orcid.org/${site.pi.orcid}`} rel="noopener">ORCID</a></li>
          <li><a href={site.social.twitter} rel="noopener">X / Twitter</a></li>
          <li><a href={site.social.linkedin} rel="noopener">LinkedIn</a></li>
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(3rem, 8vw, 6rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); }
  .email { margin-top: 2rem; font-size: var(--step-2); font-family: var(--font-display); }
  .email a { text-decoration-color: var(--accent); }
  aside h2 { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); font-family: var(--font-body); margin-top: 2rem; }
  aside h2:first-child { margin-top: 0; }
  address { font-style: normal; color: var(--ink-muted); line-height: 1.7; }
  aside ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  aside a { color: var(--ink-muted); text-decoration: none; }
  aside a:hover { color: var(--accent-ink); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
