---
const { pub, compact = false } = Astro.props;
---
<article class:list={['cite', compact && 'compact']}>
  <p class="authors">
    {pub.authors.map((a, i) => (
      <>
        <span class={a.isLab ? 'lab' : undefined}>{a.name}</span>{i < pub.authors.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>

  <h3 class="title">{pub.title}</h3>

  <p class="meta">
    {pub.venue && <em>{pub.venue}</em>}
    {pub.year && <span> {pub.year}</span>}
    {pub.detail && <span>;{pub.detail}</span>}
    {pub.preprint && <span class="tag preprint">Preprint</span>}
    {pub.inPress && <span class="tag press">In press</span>}
  </p>

  {pub.links.length > 0 && (
    <p class="links">
      {pub.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
    </p>
  )}
</article>

<style>
  .cite {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .cite:last-child { border-bottom: 0; }

  .authors {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin: 0 0 0.35rem;
    line-height: 1.5;
  }
  .authors .lab { color: var(--ink); font-weight: 600; }

  .title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.4rem;
    max-width: 58ch;
  }

  .meta { font-size: 0.88rem; color: var(--ink-muted); margin: 0; }
  .meta em { font-style: italic; color: var(--ink); }

  .tag {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
  }
  .preprint { background: var(--paper-sunk); color: var(--ink-muted); border: 1px solid var(--rule-strong); }
  .press { background: var(--accent-soft); color: var(--accent-ink); }

  .links { display: flex; gap: 1rem; margin: 0.6rem 0 0; }
  .links a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-faint);
  }
  .links a:hover { color: var(--accent); }

  .compact .title { font-size: var(--step-0); }
  .compact { padding-block: 1rem; }
</style>
